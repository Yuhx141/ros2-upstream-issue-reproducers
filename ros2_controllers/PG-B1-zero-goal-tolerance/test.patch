+TEST_F(GripperControllerTest, ZeroToleranceAcceptsExactGoal)
+{
+  this->SetUpController();
+  this->controller_->get_node()->set_parameter({"joint", "joint1"});
+  this->controller_->get_node()->set_parameter({"goal_tolerance", 0.0});
+  ASSERT_TRUE(configure_succeeds(controller_));
+  ASSERT_TRUE(activate_succeeds(controller_));
+
+  ActionHarness action(controller_->get_node()->get_node_base_interface());
+  GripperCommandAction::Goal goal;
+  goal.command.position = {joint_states_[0]};
+  auto handle = action.send(goal);
+  ASSERT_TRUE(handle);
+  auto result = action.client->async_get_result(handle);
+  ASSERT_EQ(
+    controller_->update(controller_->get_node()->now(), rclcpp::Duration::from_seconds(0.01)),
+    controller_interface::return_type::OK);
+  const auto status =
+    action.executor.spin_until_future_complete(result, std::chrono::milliseconds(250));
+  if (status != rclcpp::FutureReturnCode::SUCCESS)
+  {
+    std::cout << "ZERO_TOLERANCE_RESULT=TIMEOUT ERROR=0 TOLERANCE=0" << std::endl;
+    action.cancel(handle);
+  }
+  ASSERT_EQ(status, rclcpp::FutureReturnCode::SUCCESS);
+  EXPECT_EQ(result.get().code, rclcpp_action::ResultCode::SUCCEEDED);
+  EXPECT_TRUE(result.get().result->reached_goal);
+}
