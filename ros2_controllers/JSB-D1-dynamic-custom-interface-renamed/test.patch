+TEST_F(JointStateBroadcasterTest, dynamic_custom_mapping_preserves_source_interface_probe)
+{
+  SetUpStateBroadcaster(
+    {joint_names_[0]}, {custom_interface_name_},
+    {rclcpp::Parameter(
+      std::string("map_interface_to_joint_state.") + HW_IF_POSITION, custom_interface_name_)});
+  ASSERT_TRUE(configure_succeeds(state_broadcaster_));
+  ASSERT_TRUE(activate_succeeds(state_broadcaster_));
+  ASSERT_EQ(
+    state_broadcaster_->update(rclcpp::Time(19), rclcpp::Duration::from_seconds(0.01)),
+    controller_interface::return_type::OK);
+  ASSERT_THAT(
+    state_broadcaster_->joint_state_msg_.position,
+    ElementsAreArray(std::vector<double>{custom_joint_value_}));
+  const auto & dynamic = state_broadcaster_->dynamic_joint_state_msg_;
+  ASSERT_EQ(dynamic.interface_values.size(), 1u);
+  EXPECT_THAT(
+    dynamic.interface_values[0].interface_names,
+    ElementsAreArray(std::vector<std::string>{custom_interface_name_}));
+  EXPECT_THAT(
+    dynamic.interface_values[0].values,
+    ElementsAreArray(std::vector<double>{custom_joint_value_}));
+}
